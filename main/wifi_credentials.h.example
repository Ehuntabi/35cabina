/* wifi_credentials.h.example
 *
 * Plantilla. Copia este fichero a "wifi_credentials.h" (ignorado por git,
 * ver .gitignore) y rellena los valores reales del AP de
 * la P4 (Ajustes -> Wi-Fi en la P4, o volcando su NVS por USB — ver
 * memoria feedback_leer_placa_via_usb_sin_monitor). Sin este fichero el
 * build falla a proposito: no debe compilarse con una password de broma.
 */
#pragma once

/* El AP del 7" se llama "ESP_<3 ultimos bytes de la MAC de su AP>" y esta
 * ABIERTO (sin contrasena). No es lo que el 7" cree tener configurado: su
 * pantalla de Ajustes dice "VictronConfig" con WPA2, pero esa configuracion no
 * llega a la radio -- la levanta el C6 por esp_hosted y le pone su nombre
 * automatico. Verificado el 21-ago-2026 (esp_wifi_get_config en el 7" +
 * escaneo desde aqui), y ya era asi en julio con el satelite anterior.
 *
 * La pantalla de casa es ESP_DC078D; la de repuesto, ESP_F7C849. Mira el log
 * del 7" ("AP en la radio: ssid=...") o escanea, pero NO te fies de lo que
 * ponga su pantalla de Ajustes.
 *
 * Password VACIA porque la red esta abierta. */
#define WIFI_CRED_SSID "ESP_DC078D"
#define WIFI_CRED_PASS ""
