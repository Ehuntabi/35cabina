/* wifi_credentials.h.example
 *
 * Plantilla. Copia este fichero a "wifi_credentials.h" (ignorado por git,
 * ver .gitignore) y rellena los valores reales del AP de
 * la P4 (Ajustes -> Wi-Fi en la P4, o volcando su NVS por USB — ver
 * memoria feedback_leer_placa_via_usb_sin_monitor). Sin este fichero el
 * build falla a proposito: no debe compilarse con una password de broma.
 */
#pragma once

/* OJO: el nombre del AP sale de la NVS de la P4, no de su codigo. El valor
 * de fabrica de ALLI es "VictronConfig", pero la P4 real anuncia
 * "ESP_DC078D" (verificado en su log el 21-ago-2026:
 * cfg_srv: Starting Soft-AP, SSID=...). Mira su log o su pantalla de
 * Ajustes antes de dar por bueno un nombre. */
#define WIFI_CRED_SSID "ESP_DC078D"
#define WIFI_CRED_PASS "cambia-esto-por-la-password-real-de-la-P4"
